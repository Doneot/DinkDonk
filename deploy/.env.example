# Public deployment config
DOMAIN=example.com
ACME_EMAIL=admin@example.com
SERVER_URL=https://example.com
CLIENT_ORIGIN=https://example.com

# App config
UNSUBSCRIBE_EVENTSUB_ON_SHUTDOWN=false
PROMETHEUS_ENABLED=true
REQUEST_LOGGING_ENABLED=true

# Discord OAuth + bot (public identifiers only; see secrets note below)
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Twitch EventSub (public identifier only; see secrets note below)
TWITCH_CLIENT_ID=

# Google sign-in (optional: leave both unset to disable the feature entirely -
# the /google routes won't even be mounted). GOOGLE_CLIENT_SECRET is sensitive
# but, unlike the other secrets below, isn't wired through a Docker secret
# file: since the feature must stay off by default for existing deployments,
# a compose-level secrets: entry would force every deployment to provision a
# (non-empty) file just to boot. Set it directly here once Google OAuth
# credentials exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitch sign-in (optional, off by default). Reuses the same app/credentials
# as EventSub above - TWITCH_CLIENT_ID/SECRET is one Twitch app registration
# that serves both the client-credentials grant (EventSub) and the
# authorization-code grant (user login); it just needs the login callback URL
# (https://<domain>/api/auth/twitch/callback, or http://localhost:3000/... in
# dev - Twitch accepts a plain localhost redirect) added to that app's
# redirect list. Set to true here once that callback URL has been registered
# on the Twitch app.
TWITCH_LOGIN_ENABLED=false

# Web Push (VAPID) - generate with `npx web-push generate-vapid-keys`
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# REDIS_URL is NOT read from this file - it's set directly in
# compose.prod.yml/compose.staging.yml's environment block as
# redis://redis:6379 (the redis service defined in the same compose file,
# reachable only over the private, internal-only network - no password, same
# trust boundary as prometheus in that network). Nothing to configure here.

# The following are NOT read from this file - they're mounted as Docker
# secrets in production (see deploy/secrets/) and read via env.ts's
# secretFromEnv() fallback, which prefers a real env var if one is set and
# otherwise reads the matching file under /run/secrets/:
#   SESSION_SECRET         -> deploy/secrets/session-secret
#   DISCORD_CLIENT_SECRET  -> deploy/secrets/discord-client-secret
#   DISCORD_TOKEN          -> deploy/secrets/discord-token
#   TWITCH_CLIENT_SECRET   -> deploy/secrets/twitch-client-secret
#   TWITCH_WEBHOOK_SECRET  -> deploy/secrets/twitch-webhook-secret
#   ENCRYPTION_KEY         -> deploy/secrets/encryption-key
#     (encrypts OAuth tokens at rest; generate with `openssl rand -hex 32`.
#     Accepts a comma-separated list to rotate keys: put the new key first
#     and keep the old one listed after it until all tokens have naturally
#     been rewritten, then drop the old key.)
#   METRICS_TOKEN          -> deploy/secrets/metrics-token
#     (required bearer token for /metrics; generate with `openssl rand -hex
#     32`. Prometheus is configured with the same file via
#     monitoring/prometheus.yml's authorization.credentials_file.)
#   Firebase service account -> deploy/secrets/firebase-service-account.json
#     (mounted at /run/secrets/firebase_service_account, referenced via
#     GOOGLE_APPLICATION_CREDENTIALS)
