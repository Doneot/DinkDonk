# Public deployment config
DOMAIN=example.com
ACME_EMAIL=admin@example.com
SERVER_URL=https://example.com
CLIENT_ORIGIN=https://example.com

# App config
SESSION_SECRET=replace-with-a-long-random-secret
UNSUBSCRIBE_EVENTSUB_ON_SHUTDOWN=false

# Discord OAuth + bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Twitch EventSub
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=

# Optional app admin secret
ADMIN_PASSWORD=

# Firebase is mounted as a Docker secret in production:
# deploy/secrets/firebase-service-account.json -> /run/secrets/firebase_service_account
