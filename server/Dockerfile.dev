FROM node:22-alpine

WORKDIR /app

# Install dependencies (cached layer)
COPY package*.json ./
RUN npm ci

# Copy entrypoint
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy application
COPY . .

ENTRYPOINT ["entrypoint.sh"]

EXPOSE 3000

CMD ["node", "--import", "tsx", "src/app/index.ts"]